{
  "manifest_version": 3,
  "name": "Shackademy - Voyant Help",
  "version": "1.3.0",
  "description": "Adds field-level guidance and Shackademy lesson links to Voyant financial planning software. For Shackademy members only.",
  "homepage_url": "https://shackademy.com",
  "permissions": ["activeTab", "storage"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle Shackademy help",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.planwithvoyant.co.uk/*"],
      "js": ["fields.js", "lessons.js", "sections.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "shackademy-voyant-help@shackademy.com",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
